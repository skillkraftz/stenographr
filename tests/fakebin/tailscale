#!/bin/sh
# Fake tailscale: logs its arguments to $FAKE_TS_LOG. FAKE_TS_DENY=1: `serve` fails like a machine without operator rights.
echo "$*" >> "${FAKE_TS_LOG:-/dev/null}"
case $1 in
  status) echo '{"Self": {"DNSName": "fake-host.tail0000.ts.net."}}' ;;
  serve) [ "$FAKE_TS_DENY" = 1 ] && { echo "Access denied: serve config denied (use 'sudo tailscale set --operator=$USER')" >&2; exit 1; }; echo "Available within your tailnet" ;;
esac
