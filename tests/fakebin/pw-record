#!/bin/sh
# Fake pw-record. Logs its arguments to $FAKE_PW_LOG. FAKE_PW_FAIL=1: exit 1 at once.
#  to a file:  writes FAKE_PW_SECONDS (12) of silent stereo f32 at once, then runs until SIGINT/SIGTERM
#  to stdout ("-"): FAKE_PW_CHUNKS (3) chunks of FAKE_ENGINE_SECONDS (5) s each; before chunk N>1 it waits for
#                   $FAKE_PW_GATE/goN if FAKE_PW_GATE is set; then runs until killed
echo "$*" >> "${FAKE_PW_LOG:-/dev/null}"
[ "$FAKE_PW_FAIL" = 1 ] && { echo "fake pw-record: no such target" >&2; exit 1; }
for last; do :; done
sleep 1000 & SP=$!
trap 'kill $SP 2>/dev/null; exit 0' INT TERM
if [ "$last" = "-" ]; then
  i=1
  while [ "$i" -le "${FAKE_PW_CHUNKS:-3}" ]; do
    if [ "$i" -gt 1 ] && [ -n "$FAKE_PW_GATE" ]; then
      while [ ! -e "$FAKE_PW_GATE/go$i" ]; do sleep 0.05; done
    fi
    head -c $(( ${FAKE_ENGINE_SECONDS:-5} * 16000 * 8 )) /dev/zero
    i=$((i+1))
  done
else
  head -c $(( ${FAKE_PW_SECONDS:-12} * 16000 * 8 )) /dev/zero > "$last"
fi
wait $SP
