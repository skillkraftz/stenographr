#!/bin/sh
# Fake gsettings: values are files under $FAKE_GSETTINGS/<schema>/<key> (GVariant text, as given to `set`).
cmd=$1; schema=$2; key=$3; f="$FAKE_GSETTINGS/$schema/$key"
case $cmd in
  get)   if [ -f "$f" ]; then cat "$f"; elif [ "$key" = custom-keybindings ]; then echo "@as []"; else echo "''"; fi ;;
  set)   mkdir -p "$(dirname "$f")"; printf '%s\n' "$4" > "$f" ;;
  reset) rm -f "$f" ;;
  *) exit 2 ;;
esac
